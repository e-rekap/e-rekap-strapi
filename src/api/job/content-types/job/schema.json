{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "jobDate": {
      "type": "datetime",
      "required": true
    },
    "deadline": {
      "type": "datetime",
      "required": true
    },
    "notes": {
      "type": "text"
    },
    "jobStatus": {
      "type": "enumeration",
      "required": true,
      "default": "NOT_STARTED",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "DONE"
      ]
    },
    "sla": {
      "type": "enumeration",
      "enum": [
        "ON_TIME",
        "OVERDUE"
      ]
    },
    "slaDuration": {
      "type": "decimal"
    },
    "jobCreatedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "jobAssignedTo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "jobAssignedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "jobAssignedAt": {
      "type": "datetime"
    },
    "jobStartedAt": {
      "type": "datetime"
    },
    "jobCompletedAt": {
      "type": "datetime"
    },
    "jobCreatedAt": {
      "type": "datetime"
    },
    "jobUpdatedAt": {
      "type": "datetime"
    },
    "job_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job-history.job-history"
    }
  }
}
