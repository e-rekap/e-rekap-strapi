{
  "kind": "collectionType",
  "collectionName": "shift_schedules",
  "info": {
    "singularName": "shift-schedule",
    "pluralName": "shift-schedules",
    "displayName": "ShiftSchedule"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "shiftType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "PAGI",
        "SIANG",
        "MALAM"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "userDateKey": {
      "type": "string",
      "searchable": false,
      "required": false,
      "unique": true
    },
    "date": {
      "type": "date",
      "required": true
    }
  }
}
