{
  "kind": "collectionType",
  "collectionName": "job_histories",
  "info": {
    "singularName": "job-history",
    "pluralName": "job-histories",
    "displayName": "jobHistory"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "actionType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "CREATED",
        "ASSIGNED",
        "STARTED",
        "NOTE",
        "TAKEOVER",
        "DONE"
      ]
    },
    "job": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::job.job"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::member.member"
    },
    "previousUser": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::member.member"
    },
    "desc": {
      "type": "text"
    }
  }
}
