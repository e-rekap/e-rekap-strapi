{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./src/*"],
      "atoms/*": ["./src/atoms/*"],
      "components/*": ["./src/components/*"],
      "hocs/*": ["./src/hocs/*"],
      "hooks/*": ["./src/hooks/*"],
      "models/*": ["./src/models/*"],
      "pages/*": ["./src/pages/*"],
      "services/*": ["./src/services/*"],
      "utils/*": ["./src/utils/*"],
      "variables/*": ["./src/variables/*"]
    },
    "types": ["node"]
  },
  "include": ["src"]
}
