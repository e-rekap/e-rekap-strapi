{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "job"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "desc": {
      "type": "text",
      "required": true
    },
    "jobDate": {
      "type": "date",
      "required": true
    },
    "deadline": {
      "type": "datetime",
      "required": true
    },
    "notes": {
      "type": "string"
    },
    "jobStatus": {
      "type": "enumeration",
      "default": "NOT_STARTED",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "DONE"
      ]
    },
    "startedAt": {
      "type": "datetime"
    },
    "completedAt": {
      "type": "datetime"
    },
    "assignee": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::member.member"
    },
    "assignedAt": {
      "type": "datetime"
    }
  }
}
